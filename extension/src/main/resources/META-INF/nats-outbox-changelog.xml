<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
  <changeSet id="nats-outbox-1" author="keycloak-nats-durable" dbms="postgresql">
    <createTable tableName="KC_NATS_OUTBOX">
      <column name="ID" type="VARCHAR(36)">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="VERSION" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="REALM_ID" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="EVENT_TYPE" type="VARCHAR(128)">
        <constraints nullable="false"/>
      </column>
      <column name="SUBJECT" type="VARCHAR(512)">
        <constraints nullable="false"/>
      </column>
      <column name="PAYLOAD_SHA256" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="CREATED_AT" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ORDERING_KEY" type="VARCHAR(2048)"/>
      <column name="USER_SEQUENCE" type="BIGINT"/>
      <column name="MAX_AGE_SECONDS" type="INT"/>
      <column name="MAX_FAILURES" type="INT"/>
      <column name="EXPIRES_AT" type="BIGINT"/>
      <column name="FILTER_SHA256" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="RULE_ID" type="CLOB"/>
      <column name="PAYLOAD" type="CLOB">
        <constraints nullable="false"/>
      </column>
      <column name="NEXT_ATTEMPT_AT" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="NEXT_EXPIRY_ATTEMPT_AT" type="BIGINT"/>
      <column name="LAST_ERROR" type="VARCHAR(128)"/>
      <column name="ATTEMPTS" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="PUBLICATION_MAY_HAVE_OCCURRED" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createTable tableName="KC_NATS_DISCARD_AUDIT">
      <column name="ID" type="VARCHAR(36)">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="REALM_ID" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="EVENT_TYPE" type="VARCHAR(128)">
        <constraints nullable="false"/>
      </column>
      <column name="SUBJECT" type="VARCHAR(512)">
        <constraints nullable="false"/>
      </column>
      <column name="PAYLOAD_SHA256" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="CREATED_AT" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="ORDERING_KEY" type="VARCHAR(2048)"/>
      <column name="USER_SEQUENCE" type="BIGINT"/>
      <column name="MAX_AGE_SECONDS" type="INT"/>
      <column name="MAX_FAILURES" type="INT"/>
      <column name="EXPIRES_AT" type="BIGINT"/>
      <column name="FILTER_SHA256" type="VARCHAR(64)">
        <constraints nullable="false"/>
      </column>
      <column name="RULE_ID" type="CLOB"/>
      <column name="DISCARDED_AT" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="REASON" type="VARCHAR(32)">
        <constraints nullable="false"/>
      </column>
      <column name="ATTEMPTS" type="BIGINT" defaultValueNumeric="0">
        <constraints nullable="false"/>
      </column>
      <column name="PUBLICATION_MAY_HAVE_OCCURRED" type="BOOLEAN" defaultValueBoolean="false">
        <constraints nullable="false"/>
      </column>
    </createTable>
    <createTable tableName="KC_NATS_CAPTURE_COUNTER">
      <column name="ORDERING_KEY" type="VARCHAR(2048)">
        <constraints nullable="false" primaryKey="true"/>
      </column>
      <column name="REALM_ID" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="USER_ID" type="VARCHAR(255)">
        <constraints nullable="false"/>
      </column>
      <column name="LAST_SEQUENCE" type="BIGINT">
        <constraints nullable="false"/>
      </column>
      <column name="HEAD_EVENT_ID" type="VARCHAR(36)"/>
      <column name="HEAD_NEXT_ATTEMPT_AT" type="BIGINT"/>
      <column name="HEAD_CREATED_AT" type="BIGINT"/>
    </createTable>
    <addUniqueConstraint tableName="KC_NATS_CAPTURE_COUNTER" columnNames="REALM_ID,USER_ID" constraintName="UQ_KC_NATS_COUNTER_USER"/>
    <addUniqueConstraint tableName="KC_NATS_OUTBOX" columnNames="ORDERING_KEY,USER_SEQUENCE" constraintName="UQ_KC_NATS_OUTBOX_POSITION"/>
    <createIndex tableName="KC_NATS_OUTBOX" indexName="IDX_KC_NATS_OUTBOX_DUE">
      <column name="NEXT_ATTEMPT_AT"/>
      <column name="CREATED_AT"/>
      <column name="ID"/>
    </createIndex>
    <createIndex tableName="KC_NATS_OUTBOX" indexName="IDX_KC_NATS_OUTBOX_EXPIRY">
      <column name="NEXT_EXPIRY_ATTEMPT_AT"/>
      <column name="ID"/>
    </createIndex>
    <createIndex tableName="KC_NATS_DISCARD_AUDIT" indexName="IDX_KC_NATS_DISCARD_RETENTION">
      <column name="DISCARDED_AT"/>
      <column name="ID"/>
    </createIndex>
    <customChange class="io.github.gbeaule.keycloaknats.OutboxSchema"/>
  </changeSet>
</databaseChangeLog>
