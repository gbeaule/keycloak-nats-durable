FROM eclipse-temurin:21-jre
ARG ARTIFACT_VERSION=1.0.0-SNAPSHOT
ARG VCS_REF=development
LABEL org.opencontainers.image.source="https://github.com/gbeaule/keycloak-nats-durable" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.version="${ARTIFACT_VERSION}"
WORKDIR /app
COPY consumer-example/target/consumer-example-${ARTIFACT_VERSION}.jar /app/consumer.jar
USER 10001:10001
ENTRYPOINT ["java", "-jar", "/app/consumer.jar"]
