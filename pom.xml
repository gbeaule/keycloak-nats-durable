<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd" child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.gbeaule</groupId>
  <artifactId>keycloak-nats-durable-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>
  <name>Keycloak NATS Durable</name>
  <description>Durable Keycloak events over NATS JetStream with a transactional outbox.</description>
  <url>https://github.com/gbeaule/keycloak-nats-durable</url>
  <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/gbeaule/keycloak-nats-durable.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/gbeaule/keycloak-nats-durable.git</developerConnection>
    <url>https://github.com/gbeaule/keycloak-nats-durable</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/gbeaule/keycloak-nats-durable/issues</url>
  </issueManagement>
  <modules>
    <module>nats-transport</module>
    <module>extension</module>
    <module>consumer-example</module>
    <module>integration-tests</module>
    <module>coverage</module>
  </modules>
  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
    <project.build.outputTimestamp>2026-09-26T00:00:00Z</project.build.outputTimestamp>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.version>26.7.4</keycloak.version>
    <keycloak.runtime.version>${keycloak.version}</keycloak.runtime.version>
    <keycloak.upgrade.from>26.6.4</keycloak.upgrade.from>
    <postgres.image>postgres:18.6-alpine</postgres.image>
    <jnats.version>2.26.3</jnats.version>
    <hikaricp.version>7.1.0</hikaricp.version>
    <bouncycastle.version>2.73.13</bouncycastle.version>
    <junit.version>6.1.3</junit.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <jacoco.version>0.8.15</jacoco.version>
    <!-- Production modules set their initial floors; raise them as gaps are closed. -->
    <coverage.line.minimum>0.00</coverage.line.minimum>
    <coverage.branch.minimum>0.00</coverage.branch.minimum>
    <jacoco.unit.argLine/>
    <argLine/>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.zaxxer</groupId>
        <artifactId>HikariCP</artifactId>
        <version>${hikaricp.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.keycloak</groupId>
        <artifactId>keycloak-parent</artifactId>
        <version>${keycloak.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.nats</groupId>
        <artifactId>jnats</artifactId>
        <version>${jnats.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcprov-lts8on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcutil-lts8on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.bouncycastle</groupId>
        <artifactId>bcpkix-lts8on</artifactId>
        <version>${bouncycastle.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>42.7.13</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <argLine>@{jacoco.unit.argLine} @{argLine}</argLine>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>3.6.0</version>
          <configuration>
            <useModulePath>false</useModulePath>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.6.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <configuration>
            <!-- Shade must never consume a prior shaded output on an incremental build. -->
            <forceCreation>true</forceCreation>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>3.6.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <dependencies>
          <dependency>
            <groupId>com.puppycrawl.tools</groupId>
            <artifactId>checkstyle</artifactId>
            <version>14.1.0</version>
          </dependency>
        </dependencies>
        <configuration>
          <configLocation>google_checks.xml</configLocation>
          <violationSeverity>warning</violationSeverity>
          <includeTestSourceDirectory>true</includeTestSourceDirectory>
          <consoleOutput>true</consoleOutput>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <id>google-java-style</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.10.2</version>
        <configuration>
          <lineEndings>UNIX</lineEndings>
          <java>
            <googleJavaFormat>
              <version>1.27.0</version>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>java-and-maven</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>unit-coverage-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
            <configuration>
              <!-- Failsafe and container JVMs must not contribute to unit coverage. -->
              <propertyName>jacoco.unit.argLine</propertyName>
              <destFile>${project.build.directory}/jacoco-unit.exec</destFile>
              <append>false</append>
            </configuration>
          </execution>
          <execution>
            <id>unit-coverage-report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-unit.exec</dataFile>
              <outputDirectory>${project.build.directory}/site/jacoco-unit</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>unit-coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <dataFile>${project.build.directory}/jacoco-unit.exec</dataFile>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.line.minimum}</minimum>
                    </limit>
                    <limit>
                      <counter>BRANCH</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${coverage.branch.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>mutation</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
            <version>1.30.0</version>
            <dependencies>
              <dependency>
                <groupId>org.pitest</groupId>
                <artifactId>pitest-junit5-plugin</artifactId>
                <version>1.2.3</version>
              </dependency>
            </dependencies>
            <configuration>
              <targetClasses>
                <param>io.github.gbeaule.keycloaknats.*</param>
              </targetClasses>
              <targetTests>
                <param>io.github.gbeaule.keycloaknats.*Test</param>
              </targetTests>
              <threads>2</threads>
              <timestampedReports>false</timestampedReports>
              <outputFormats>
                <param>HTML</param>
                <param>XML</param>
              </outputFormats>
              <failWhenNoMutations>false</failWhenNoMutations>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>sbom</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <version>2.9.3</version>
            <executions>
              <execution>
                <id>complete-inventory</id>
                <phase>verify</phase>
                <goals><goal>makeAggregateBom</goal></goals>
              </execution>
              <execution>
                <id>bundled-runtime-inventory</id>
                <phase>verify</phase>
                <goals><goal>makeAggregateBom</goal></goals>
                <configuration>
                  <includeProvidedScope>false</includeProvidedScope>
                  <outputName>runtime-bom</outputName>
                  <classifier>runtime-cyclonedx</classifier>
                </configuration>
              </execution>
            </executions>
            <configuration>
              <schemaVersion>1.6</schemaVersion>
              <includeTestScope>false</includeTestScope>
              <includeProvidedScope>true</includeProvidedScope>
              <includeBomSerialNumber>false</includeBomSerialNumber>
              <outputFormat>json</outputFormat>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
