{
  "userEvents": [
    "*"
  ],
  "adminEvents": [
    {
      "resourceType": "*",
      "operations": [
        "*"
      ]
    }
  ],
  "delivery": {
    "rules": [
      {
        "id": "protected-user-lifecycle",
        "match": {
          "kind": "admin",
          "resourceType": "USER",
          "operations": ["CREATE", "UPDATE", "DELETE"]
        },
        "policy": {"action": "retry"}
      },
      {
        "id": "short-lived-login",
        "match": {
          "kind": "user",
          "eventTypes": [
            "LOGIN",
            "LOGIN_ERROR"
          ]
        },
        "policy": {
          "action": "discard",
          "maxAgeSeconds": 300,
          "maxFailures": 20
        }
      }
    ]
  }
}
